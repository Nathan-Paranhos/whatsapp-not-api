# O servidor sempre escuta somente no computador local.
PORT=3333

# Defina como false para abrir o painel sem iniciar o navegador do WhatsApp.
WHATSAPP_AUTOSTART=true

# Caminhos opcionais (relativos ao projeto ou absolutos). Por padrão, dados
# sensíveis ficam em %LOCALAPPDATA%\WhatsAppNotApi, fora do OneDrive.
# DATABASE_PATH=C:\caminho-local\whatsapp-not-api.db
# WHATSAPP_SESSION_PATH=C:\caminho-local\whatsapp-session
